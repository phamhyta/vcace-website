---
// Placeholder artwork shown until a real, licensed photo is uploaded in the CMS.
// Muted tones follow the brief's prototype images.
const { variant } = Astro.props;
const tones = ['#D4C7BA', '#D9D5CB', '#E8DFD0', '#D7C9B6'];
const i = Number(String(variant).replace('p', '')) || 0;
---
{variant === 'hero' && (
<svg viewBox="0 0 610 535" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <rect width="610" height="535" fill="#E3DFD6"/>
  <rect x="370" y="5" width="240" height="26" fill="#F4C430"/>
  <rect x="60" y="50" width="200" height="420" fill="#D2C9BC"/>
  <rect x="260" y="90" width="230" height="330" fill="#F1EFEA"/>
  <path d="M340 175A150 150 0 1 0 412 330" fill="none" stroke="#B9AA94" stroke-width="7"/>
  <circle cx="447" cy="258" r="143" fill="none" stroke="#ADA597" stroke-width="7"/>
</svg>
)}
{variant?.startsWith?.('p') && (
<svg viewBox="0 0 340 232" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <rect width="340" height="232" fill={tones[i % 4]}/>
  <rect x={36 + i * 6} y="56" width="150" height="124" fill="none" stroke="#A59A8C" stroke-width="4"/>
  <circle cx={238 - i * 4} cy={88 + i * 6} r="62" fill="none" stroke="#F2EEE6" stroke-width="5"/>
</svg>
)}
{variant === 'project' && (
<svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <rect width="400" height="300" fill="#2c2c2c"/>
  <rect x="300" y="0" width="100" height="14" fill="#F4C430"/>
  <rect x="40" y="50" width="110" height="140" fill="none" stroke="#8a8578" stroke-width="3"/>
  <circle cx="250" cy="150" r="80" fill="none" stroke="#bdb6a8" stroke-width="4"/>
  <path d="M0 250h400" stroke="#55524c" stroke-width="2"/>
</svg>
)}
