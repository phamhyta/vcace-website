---
import home from '../content/home.json';
import Logo from './Logo.astro';
const { isHome = false, footer = home.footer } = Astro.props;
---
<footer>
  <div class="wrap">
    <div class="top">
      <a class="logo" href={isHome ? '#top' : '/'} aria-label="VCACE home">
        <Logo variant="full" tone="light" class="logo-footer" />
      </a>
      <ul aria-label="Footer">
        <li><a href={isHome ? '#collaborate' : '/#collaborate'}>Contact</a></li>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/terms/">Terms</a></li>
        <li><a href="/accessibility/">Accessibility</a></li>
      </ul>
    </div>
    {footer.acknowledgement && (
      <div class="ack">
        <h2>{footer.acknowledgementHeading || 'Acknowledgement of Country'}</h2>
        <p>{footer.acknowledgement}</p>
      </div>
    )}
    <div class="fine">
      <span>Connecting cultures. Inspiring exchange.</span>
      <span>
        {footer.legalHostLine && (
          <>{footer.legalHostUrl ? <a href={footer.legalHostUrl} rel="noopener">{footer.legalHostLine}</a> : footer.legalHostLine} · </>
        )}
        © <span id="yr">2026</span> VCACE{footer.credits && <> · {footer.credits}</>}
      </span>
    </div>
  </div>
</footer>
