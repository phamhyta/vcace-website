---
import homeJson from '../content/home.json';
import Logo from './Logo.astro';
import { ui, home, type Lang } from '../lib/i18n';
const { lang = 'en' as Lang, isHome = false, footer = homeJson.footer } = Astro.props;
const t = ui[lang as Lang];
const base = home(lang);
---
<footer>
  <div class="wrap">
    <div class="top">
      <a class="logo" href={isHome ? '#top' : base} aria-label={t.homeLabel}>
        <Logo variant="full" tone="light" class="logo-footer" />
      </a>
      <ul aria-label={t.footerNav}>
        <li><a href={isHome ? '#collaborate' : `${base}#collaborate`}>{t.contact}</a></li>
        <li><a href={`${base}privacy/`}>{t.privacy}</a></li>
        <li><a href={`${base}terms/`}>{t.terms}</a></li>
        <li><a href={`${base}accessibility/`}>{t.accessibility}</a></li>
      </ul>
    </div>
    {footer.acknowledgement && (
      <div class="ack">
        <h2>{footer.acknowledgementHeading || 'Acknowledgement of Country'}</h2>
        <p>{footer.acknowledgement}</p>
      </div>
    )}
    <div class="fine">
      <span>{t.tagline}</span>
      <span>
        {footer.legalHostLine && (
          <>{footer.legalHostUrl ? <a href={footer.legalHostUrl} rel="noopener">{footer.legalHostLine}</a> : footer.legalHostLine} · </>
        )}
        © <span id="yr">2026</span> VCACE{footer.credits && <> · {footer.credits}</>}
      </span>
    </div>
  </div>
</footer>
