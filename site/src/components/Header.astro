---
import Logo from './Logo.astro';
const { isHome = false, nav = { projects: true, people: true } } = Astro.props;
// On sub-pages, section links go back to the home page anchors.
const h = (id: string) => (isHome ? `#${id}` : `/#${id}`);
---
<header>
  <div class="wrap">
    <a class="logo" href={isHome ? '#top' : '/'} aria-label="VCACE home">
      <Logo variant="full" class="logo-full" />
      <Logo variant="short" class="logo-short" />
    </a>
    <button class="menu-btn" aria-expanded="false" aria-controls="nav">Menu</button>
    <nav id="nav" aria-label="Primary">
      <ul>
        <li><a href={h('vision')}>Our Vision</a></li>
        <li><a href={h('programs')}>Programs</a></li>
        {nav.people && <li><a href={h('people')}>People &amp; Partners</a></li>}
        {nav.projects && <li><a href={h('projects')}>Upcoming Projects</a></li>}
        <li><a class="nav-cta" href={h('collaborate')}>Collaborate with us</a></li>
      </ul>
    </nav>
  </div>
</header>
