---
import Base from '../layouts/Base.astro';
import { getContent } from '../lib/content';
import { toHtml, type Post } from '../lib/posts';
import { ui, home, type Lang } from '../lib/i18n';

const { post, lang = 'en' } = Astro.props as { post: Post; lang?: Lang };
const t = ui[lang];
const { home: homeDoc, projects, executive, advisory, strategic, partners } = await getContent(lang);
const fmt = (d: string) => (d ? new Date(d).toLocaleDateString(t.dateLocale, { day: 'numeric', month: 'long', year: 'numeric' }) : '');
---
<Base
  lang={lang}
  meta={{ title: `${post.title} | VCACE`, description: post.excerpt || post.dek }}
  nav={{ projects: projects.length > 0, people: executive.length + advisory.length + strategic.length + partners.length > 0 }}
  footer={homeDoc.footer}
>
  <article class="post">
    <div class="wrap">
      <p class="back"><a href={`${home(lang)}news/`}><span aria-hidden="true">←</span> {t.allNews}</a></p>
      <div class="post-head">
        <p class="post-meta">
          <time datetime={post.date}>{fmt(post.date)}</time>
          {!post.translated && t.englishOnly && <span class="lang-note">{t.englishOnly}</span>}
        </p>
        <h1>{post.title}</h1>
        {post.dek && <p class="dek">{post.dek}</p>}
      </div>
      {post.image && <figure><img src={post.image} alt={post.imageAlt} /></figure>}
      <div class="post-body" lang={post.translated ? undefined : 'en'} set:html={toHtml(post.body, home(lang))} />
      <p class="post-cta"><a class="btn primary" href={home(lang)}>{t.exploreVcace}</a></p>
    </div>
  </article>
</Base>
