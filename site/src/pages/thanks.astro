---
// Shown only when the enquiry form is sent without JavaScript.
import Base from '../layouts/Base.astro';
---
<Base meta={{ title: 'Message sent | VCACE', description: 'Your enquiry was sent to VCACE.' }} noindex>
  <article class="doc">
    <div class="wrap">
      <h1>Message sent</h1>
      <p class="lead">Thank you for getting in touch. VCACE will reply to your enquiry soon.</p>
      <div class="btns"><a class="btn primary" href="/">Back to the home page</a></div>
    </div>
  </article>
</Base>
